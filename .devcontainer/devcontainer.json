{
  "name": "IINK development",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "postCreateCommand": "rustup --version && rustc --version && cargo --version && protoc --version",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "portsAttributes": {
    "9944": {
      "label": "IINK development RPC",
      "onAutoForward": "ignore"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "files.watcherExclude": { "**/target/**": true },
        "search.exclude": { "**/target": true }
      }
    }
  }
}
